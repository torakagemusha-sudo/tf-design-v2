      "require": "./src/styles/tailwind.config.js"
    },
    "./types": {
      "import": "./src/types/index.d.ts",
      "require": "./src/types/index.d.ts"
    },
    "./components": {
      "import": "./src/components/index.ts",
      "require": "./src/components/index.ts"
    },
    "./hooks": {
      "import": "./src/hooks/index.ts",
      "require": "./src/hooks/index.ts"
    },
    "./utils": {
      "import": "./src/utils/index.ts",
      "require": "./src/utils/index.ts"
    },
    "./state-machines": {
      "import": "./src/state-machines/index.ts",
      "require": "./src/state-machines/index.ts"
    },
    "./layouts": {
      "import": "./src/layouts/index.ts",
      "require": "./src/layouts/index.ts"
    },
    "./rules": {
      "import": "./src/rules/index.ts",
      "require": "./src/rules/index.ts"
    }
