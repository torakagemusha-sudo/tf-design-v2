    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc --noEmit && echo 'Build complete'",
    "typecheck": "tsc --noEmit"
  },
  "main": "index.js",
  "keywords": [],
  "type": "commonjs",
  "bugs": {
