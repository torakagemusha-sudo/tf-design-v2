{
  "name": "@torakagemusha-sudo/tf-design-v2",
  "version": "0.2.0",
  "description": "Torafirma Design System v2 — expanded foundation with 12 component families, state machines, layouts, rules, hooks, and utilities for operational interfaces.",
  "license": "MIT",
  "author": "Torafirma Engineering",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torakagemusha-sudo/tf-design-v2.git"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./src/styles/tokens.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/themes.css": "./src/styles/themes.css",
    "./styles/components.css": "./src/styles/components.css",
    "./styles/utilities.css": "./src/styles/utilities.css",
    "./tokens": "./src/styles/tokens.css",
    "./tailwind": "./src/styles/tailwind.config.js",
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./state-machines": {
      "types": "./dist/state-machines/index.d.ts",
      "import": "./dist/state-machines/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "import": "./dist/layouts/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=3.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "tailwindcss",
    "component-library",
    "design-tokens",
    "dark-theme",
    "command-ui",
    "operator-ui",
    "dashboard",
    "state-machine",
    "governance",
    "audit-trail"
  ],
  "bugs": {
    "url": "https://github.com/torakagemusha-sudo/tf-design-v2/issues"
  },
  "homepage": "https://github.com/torakagemusha-sudo/tf-design-v2#readme"
}
